{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": {
      "*": "deny",
      "scripts/**": "allow",
      "tests/scripts/**": "allow",
      "docs/operations/**": "allow",
      "coordination/task-board/**": "allow",
      "coordination/progress/**": "allow",
      "coordination/delivery/**": "allow",
      "coordination/reviews/**": "allow",
      "coordination/incidents/**": "allow"
    },
    "bash": {
      "*": "deny",
      "git status *": "allow",
      "git diff *": "allow",
      "git mv coordination/task-board/ready/* coordination/task-board/in_progress/*": "allow",
      "git mv coordination/task-board/in_progress/* coordination/task-board/review/*": "allow",
      "python scripts/validate_coordination_files.py": "allow",
      "python -m py_compile scripts/*": "allow"
    },
    "external_directory": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "task": "deny",
    "lsp": "deny",
    "skill": "deny",
    "question": "deny"
  }
}
